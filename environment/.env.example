# ProcureIQ environment template
# Replace these placeholders with your own local values.
# NEVER commit real API keys or secrets to Git.

DATABASE_URL=your_database_url_here

CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_PLAN_STARTER_ID=your_starter_plan_id_here
RAZORPAY_PLAN_BUSINESS_ID=your_business_plan_id_here
RAZORPAY_PLAN_PRO_ID=your_pro_plan_id_here

GEMINI_API_KEY=your_gemini_api_key_here

RESEND_API_KEY=your_resend_api_key_here

PORT=3000
